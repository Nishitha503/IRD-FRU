# =========================================================================
# Department of Inland Revenue (IRD) - Forced Registration Unit (FRU)
# Google Firebase Cloud Database & Authentication Configuration
# =========================================================================
# To connect your Firebase Cloud Database:
# 1. Go to https://console.firebase.google.com/ and create or open your project.
# 2. In Project Settings > General > "Your apps", select Web (</>) and copy the config values.
# 3. Enable "Authentication" (Email/Password provider) in Firebase Console.
# 4. Enable "Cloud Firestore" database in Firebase Console (Test mode or Production mode).
# 5. Paste your real keys below and restart the server (npm run dev).
# =========================================================================

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

